# Copy to .env for local runs (docker compose reads these too).
# App database (Postgres, provided by docker compose):
DATABASE_URL=postgresql+psycopg2://retail:retail@localhost:5432/retail_credit

# Used by the test suite. Defaults to a local SQLite file if unset so the
# suite runs without a database server. Point it at a throwaway Postgres
# database to exercise the real engine.
# TEST_DATABASE_URL=postgresql+psycopg2://retail:retail@localhost:5432/retail_credit_test

# Path to the seed file for business-rule parameters.
BUSINESS_RULES_FILE=config/business_rules.yaml

# --- auth (Step 5) ---
# CHANGE THIS in any real deployment — tokens are signed with it.
JWT_SECRET_KEY=dev-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Bootstrap admin, created on startup if missing (also: python -m scripts.create_admin).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
