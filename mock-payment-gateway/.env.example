# Copy to .env for a local, non-docker run of this service
# (docker compose sets these directly in docker-compose.yml).

# This service's own store — deliberately separate from retail-credit-api's
# Postgres database (see README.md).
DATABASE_URL=sqlite:///./gateway.db

# MUST be identical to GATEWAY_WEBHOOK_SECRET in the main app's .env.example.
# Never committed for real use — this is a dev-only placeholder.
WEBHOOK_SECRET=dev-insecure-shared-webhook-secret-change-me

# Where this service's own hosted checkout pages are reachable from a
# browser (used to build the checkout_url handed back to retail-credit-api).
PUBLIC_BASE_URL=http://localhost:8100

# Fallback webhook destination if a checkout-session request doesn't supply
# one explicitly. Inside docker compose the main app's service is named "api".
DEFAULT_WEBHOOK_URL=http://api:8000/integrations/mock-gateway/webhooks

CHECKOUT_SESSION_EXPIRY_MINUTES=15
# "Delayed settlement" demo scenario — seconds after CAPTURED before the
# SETTLED webhook fires.
DELAYED_SETTLEMENT_SECONDS=15
